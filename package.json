{
  "name": "the-second-oasis",
  "version": "0.1.0",
  "description": "《第二绿洲》网页策略桌游 - A 优先级核心规则逻辑",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:gh": "tsc --noEmit && vite build --base=/the-second-oasis/",
    "preview": "vite preview",
    "preview:gh": "vite preview --base=/the-second-oasis/",
    "server": "tsx server/index.ts",
    "dev:full": "concurrently -n client,server -c blue,green \"npm run dev\" \"npm run server\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:net": "vitest run specs/Net/",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc --noEmit -p server/tsconfig.json"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "concurrently": "^10.0.4",
    "tsx": "^4.23.1",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0",
    "ws": "^8.21.1"
  }
}
