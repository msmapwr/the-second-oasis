  <!-- ========== 关键数据流 ========== -->
  <dataflow>
    <path name="本地对局" desc="AppController.Run() → InputGate → GameStore.PlayTurn() → GameState → AnimationCoordinator → Renderers + Audio"/>
    <path name="联机对局" desc="AppController → NetworkGameStore → WebSocketClient → Server:GameRoom(GameState权威) → 广播 → 各客户端NetworkGameStore"/>
    <path name="AI对局" desc="AIDirector.PlayForCurrentPlayer() → AIPlayer.DecideMode() → DecisionMaker → Evaluator + Simulator"/>
    <path name="渲染管线" desc="LayeredCanvas(3层) → OasisBoardRenderer(主层) + StarfieldRenderer(背景) + DiceStage(FX层) + AnimationManager(全部层)"/>
  </dataflow>

